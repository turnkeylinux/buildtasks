APP=$(basename "$0")
fatal() { echo "FATAL [$APP]: $*" 1>&2; exit 1; }
warning() { echo "WARNING [$APP]: $*"; }
info() { echo "INFO [$APP]: $*"; }

usage() {
cat<<EOF
Syntax: $APP
Setup/update system ready for bt-x --publish and/or bt-ec2

Options::

    --awscli        Just install awscli
                    (support for --publish only - not bt-ec2)

Environment::

    BT_DEBUG        turn on debugging

EOF
exit 1
}

[[ -n "$BT_DEBUG" ]] && set -x

install() {
    info "Installing/updating packages as needed: $*"
    apt-get -qq update
    DEBIAN_FRONTEND=noninteractive apt-get -y install "$@"
}

distro=$(lsb_release -sc)
pkgs=(tklpatch tkl-ec2metadata python3-boto3 awscli)
case $distro in
    bullseye|bookworm)
        pkgs+=(python3-boto);;
    trixie|forky)
        pkgs+=(python3-botocore);;
    *)
        fatal "Unexpected distro: $distro";;
esac
while [ "$1" != "" ]; do
    case $1 in
        --awscli)       pkgs=(awscli);;
        --help|-h)      usage;;
        *)              usage;;
    esac
    shift
done

install "${pkgs[@]}"
