#!/usr/bin/env python
"""Run CloudTask using the EC2 key already provisioned on existing workers."""
from cloudtask import main
from cloudtask.ssh import SSH

# EC2 has already installed this batch's public key. Avoid rewriting
# authorized_keys and isolate the client from unrelated agent identities.
SSH.copy_id = lambda self, key: None
SSH.remove_id = lambda self, key: None
original_argv = SSH.Command.argv.__func__

@classmethod
def isolated_argv(cls, *args, **kwargs):
    argv = original_argv(cls, *args, **kwargs)
    return argv[:1] + ['-F', '/dev/null', '-o', 'IdentitiesOnly=yes', '-o', 'IdentityAgent=none'] + argv[1:]

SSH.Command.argv = isolated_argv
main()
