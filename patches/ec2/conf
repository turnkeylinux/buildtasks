#!/bin/bash -ex

install_packages() {
    apt-get update
    DEBIAN_FRONTEND=noninteractive apt-get -y \
        -o DPkg::Options::=--force-confdef \
        -o DPkg::Options::=--force-confold \
        install $@
}

install_packages hubclient sudo parted gdisk #ebsmount

# The EC2 policy is shared by Hub and Marketplace launches.
legacy_ssh_policy=/etc/ssh/sshd_config.d/00-turnkey-aws-marketplace.conf
ssh_policy=/etc/ssh/sshd_config.d/00-turnkey-ec2.conf
if [ -e "$legacy_ssh_policy" ] || [ -L "$legacy_ssh_policy" ]; then
    [ -f "$legacy_ssh_policy" ] && [ ! -L "$legacy_ssh_policy" ]
    if [ -e "$ssh_policy" ] || [ -L "$ssh_policy" ]; then
        [ -f "$ssh_policy" ] && [ ! -L "$ssh_policy" ]
        cmp -s "$legacy_ssh_policy" "$ssh_policy" || {
            echo 'Conflicting EC2 SSH policies; conversion stopped without discarding either file.' >&2
            exit 1
        }
        rm "$legacy_ssh_policy"
    else
        mv "$legacy_ssh_policy" "$ssh_policy"
    fi
fi
# Current 19.x images use admin. Older Hub releases retain their root contract.
if grep -Eq -- '-19[.].*-trixie-' /etc/turnkey_version && [ ! -e "$ssh_policy" ] && [ ! -L "$ssh_policy" ]; then
    install -d -m 755 /etc/ssh/sshd_config.d
    printf '%s\n' 'PasswordAuthentication no' 'KbdInteractiveAuthentication no' \
        'PermitRootLogin no' 'PubkeyAuthentication yes' |
        install -o 0 -g 0 -m 644 /dev/stdin "$ssh_policy"
fi

# EC2 instances install security updates at launch, including Marketplace launches
# without Hub preseeding. Keep the interactive initialization fence in place.
sed -i 's/^export SEC_UPDATES=SKIP$/export SEC_UPDATES=FORCE/' \
    /usr/lib/inithooks/firstboot.d/29preseed

# grub tweaks
DEFAULT=/etc/default/grub
sed -i 's/^\(GRUB_CMDLINE_LINUX_DEFAULT=.*\)"$/\1 xencons=ttyS0 console=ttyS0"/' $DEFAULT
sed -i 's/^\(GRUB_HIDDEN_TIMEOUT_QUIET=\).*$/\1true/;' $DEFAULT
sed -i 's/^\(GRUB_TIMEOUT=\).*$/\1"0"/;' $DEFAULT
sed -i 's/^#\(GRUB_DISABLE_RECOVERY\)/\1/;' $DEFAULT

# make sure images are world readable
chmod 644 /var/lib/inithooks/turnkey-init-fence/htdocs/*.png

# enable sudoadmin in rootfs
turnkey-sudoadmin on --disable-setpass

# provide for AWSMP requirment of "no default passwords"
additional_users=$(grep ":[1-9][0-9][0-9][0-9]:" /etc/passwd | cut -d: -f1)
for user in $additional_users; do
    passwd -l $user
    if [[ $user = "ansible" ]]; then
        ansible_init=/usr/lib/inithooks/firstboot.d/50ansible-key
        sed -i "/.ssh/ s|root|home/admin|" $ansible_init
    fi
done

# init fence now launches confconsole with full options, so autolaunch disabled
# on other headless builds. However, we want it on Hub builds.
confconsole_auto='/root/.bashrc.d/confconsole-auto'
[[ -f "$confconsole_auto" ]] && chmod -x "$confconsole_auto"
