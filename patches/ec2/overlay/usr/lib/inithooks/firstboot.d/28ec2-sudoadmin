#!/bin/bash -e

[ -n "$_TURNKEY_INIT" ] && exit 0

# Trixie uses the configured account selection for Hub and other launches.
# Keep the admin default and any explicit customer choice.
if grep -q -- '-trixie-' /etc/turnkey_version; then
    exit 0
fi

if grep -q SERVERID= /var/lib/hubclient/server.conf >/dev/null 2>&1; then
    # hub launch, disable sudoadmin
    sed -i "s/^SUDOADMIN=.*/SUDOADMIN=false/" /etc/default/inithooks
else
    # non-hub launch
    exit 0
fi

