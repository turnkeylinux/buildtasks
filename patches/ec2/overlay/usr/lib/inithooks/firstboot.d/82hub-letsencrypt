#!/bin/bash

if ! systemctl start hubdns.service; then
    logger -t turnkey-tklapp-letsencrypt \
        "HubDNS could not publish the managed hostname before TLS setup"
fi

if ! /usr/local/sbin/turnkey-tklapp-letsencrypt; then
    logger -t turnkey-tklapp-letsencrypt \
        "Initial certificate request failed; the hourly retry remains enabled"
fi

exit 0
