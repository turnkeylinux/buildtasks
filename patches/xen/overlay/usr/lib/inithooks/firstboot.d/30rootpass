#!/bin/bash -e
# reconfigure: no
# reconfigure-title: Initial System Password
# reconfigure-description: Set the initial root password when no external password was supplied.
# set root password (unless already set OOB)

. /etc/default/inithooks

if grep -qs ^root:U6aMy0wojraho /etc/shadow; then
    [ -e $INITHOOKS_CONF ] && . $INITHOOKS_CONF
    $INITHOOKS_PATH/bin/setpass.py root --pass="$ROOT_PASS"
fi

exit 0

