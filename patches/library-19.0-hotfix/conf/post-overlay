#!/usr/bin/python3
"""Shared signed-package/configuration maintenance for pristine 19.0 roots."""
import json
import os
from pathlib import Path
import re
import subprocess

ROOT = Path('/')
PINS = json.loads(Path(__file__).with_name('packages.json').read_text())
APT_AUTH = ['-o', 'APT::Get::AllowUnauthenticated=false',
            '-o', 'Acquire::AllowInsecureRepositories=false',
            '-o', 'Acquire::AllowDowngradeToInsecureRepositories=false']
SECURITY_SOURCES = '/etc/apt/sources.list.d/security.sources.sources'
SECURITY_APT = [*APT_AUTH, '-o', 'Dir::Etc::sourceparts=/dev/null',
                '-o', 'Dir::Etc::sourcelist=' + SECURITY_SOURCES]
APT_INSTALL = ['apt-get', '-y', '--no-remove', '--no-install-recommends', *APT_AUTH,
               '-o', 'DPkg::Options::=--force-confdef', '-o', 'DPkg::Options::=--force-confold', 'install']


def require(ok, message):
    if not ok:
        raise ValueError(message)


def run(argv):
    env = dict(os.environ, LC_ALL='C', DEBIAN_FRONTEND='noninteractive')
    return subprocess.run(argv, check=True, text=True, capture_output=True, env=env).stdout.strip()


def version(name):
    result = subprocess.run(['dpkg-query', '-W', '-f=${Version}', name], text=True, capture_output=True)
    require(result.returncode in (0, 1), 'could not query package: ' + name)
    return result.stdout.strip() if result.returncode == 0 else ''


def pristine():
    release = (ROOT / 'etc/os-release').read_text()
    require(re.search(r'^ID="?debian"?$', release, re.M) and
            re.search(r'^VERSION_ID="?13"?$', release, re.M), 'requires Debian 13')
    require(run(['dpkg', '--print-architecture']) == 'amd64', 'requires amd64')
    require(re.fullmatch(r'turnkey-[a-z0-9-]+-19\.0(?:[.-][0-9]+)*-trixie-amd64',
                         (ROOT / 'etc/turnkey_version').read_text().strip()), 'requires TurnKey 19.0')
    require('RUN_FIRSTBOOT=true' in (ROOT / 'etc/default/inithooks').read_text().splitlines(), 'root has completed setup')
    for name in ('turnkey-mail/state.json', 'hubdns/sub_apikey', 'tklbam/key', 'turnkey-onboarding/state.json'):
        require(not (ROOT / 'var/lib' / name).exists(), 'initialized service state: ' + name)
    for home in (ROOT / 'root', ROOT / 'home'):
        require(not any(p.is_file() and p.stat().st_size for p in home.rglob('authorized_keys')), 'source has authorized keys')


def candidate(name, pin):
    result = subprocess.run(['apt-cache', 'show', name + '=' + pin['version']], text=True, capture_output=True)
    hashes = re.findall(r'^SHA256: ([0-9a-f]{64})$', result.stdout, re.M)
    require(not hashes or set(hashes) == {pin['sha256']}, 'signed APT candidate hash differs: ' + name)
    return bool(hashes)


def security_candidates():
    listing = run(['apt', *SECURITY_APT, 'list', '--upgradable'])
    targets = []
    for line in listing.splitlines():
        if line == 'Listing...':
            continue
        match = re.fullmatch(r'([a-z0-9.+-]+)/\S+ (\S+) (\S+) \[upgradable from: \S+\]', line)
        require(match, 'unexpected APT security candidate: ' + line)
        name, revision, architecture = match.groups()
        if architecture != 'all':
            name += ':' + architecture
        targets.append(name + '=' + revision)
    return targets


def install_security_updates():
    indexes = run(['apt-get', *SECURITY_APT, 'indextargets', '--format',
                   '$(FILENAME) $(TRUSTED)', 'Created-By: Packages'])
    require(indexes, 'no security package indexes')
    for entry in indexes.splitlines():
        filename, trusted = entry.rsplit(' ', 1)
        index = ROOT / filename.lstrip('/')
        require(trusted == 'yes' and index.is_file() and index.stat().st_size > 0,
                'missing or unauthenticated security index: ' + filename)
    targets = security_candidates()
    if targets:
        # Use the full signed sources here, so stable can supply dependencies.
        run(APT_INSTALL + targets)
    pending = security_candidates()
    require(not pending, 'security upgrades still pending: ' + ', '.join(pending))
    print(f'SECURITY_UPDATES_VERIFIED installed={len(targets)} pending=0')


def apply():
    pristine()
    require(subprocess.run(['/usr/sbin/policy-rc.d']).returncode == 101, 'caller must suppress service startup')
    sources = (ROOT / SECURITY_SOURCES.lstrip('/')).read_text()
    require(not re.search(r'(?im)^(?:Trusted|Allow-Insecure|Allow-Weak|Allow-Downgrade-To-Insecure)'
                          r'\s*:\s*(?:yes|true|1|on)\s*$', sources), 'APT security signature override')
    run(['apt-get', *APT_AUTH, '-o', 'APT::Update::Error-Mode=any', 'update'])
    targets = {}
    for name, pin in PINS.items():
        installed = version(name)
        if not pin['minimum'] or not installed or subprocess.run(
                ['dpkg', '--compare-versions', installed, 'ge', pin['version']]).returncode:
            targets[name] = pin
    require(all(candidate(name, pin) for name, pin in targets.items()), 'required signed APT candidate absent')
    run(APT_INSTALL + [name + '=' + pin['version'] for name, pin in targets.items()])
    install_security_updates()
    for name, pin in PINS.items():
        installed = version(name)
        if pin['minimum']:
            run(['dpkg', '--compare-versions', installed, 'ge', pin['version']])
        else:
            require(installed == pin['version'], 'installed version differs: ' + name)
    # Package upgrades can replace the native Webmin module. Repair it last.
    run(['sh', str(Path(__file__).with_name('ssh-access'))])
    run(['visudo', '-c'])
    require(run(['sudo', '-n', '--', 'id', '-u']) == '0', 'root sudo compatibility failed')
    config = ROOT / 'etc/webmin/miniserv.conf'
    lines = config.read_text().splitlines()
    chain = [line for line in lines if line.startswith('extracas=')]
    canonical = 'extracas=/etc/ssl/private/cert.pem'
    require(chain in ([], ['extracas='], [canonical]), 'source has a different Webmin chain configuration')
    if chain == ['extracas=']:
        lines[lines.index('extracas=')] = canonical
        config.write_text('\n'.join(lines) + '\n')
    elif not chain:
        config.write_text('\n'.join(lines + [canonical]) + '\n')
    pristine()


if __name__ == '__main__':
    apply()
