#!/bin/bash -e
# reconfigure: no
# reconfigure-title: EC2 Boot Configuration
# reconfigure-description: Select bootloader settings for the EC2 virtualization mode.

[ -n "$_TURNKEY_INIT" ] && exit 0

aptconf_tag() {
    grep -q $1 /etc/apt/apt.conf.d/01turnkey && return
    sed -i "s|turnkey-\(.*\))|turnkey-\1 $1)|" /etc/apt/apt.conf.d/01turnkey
}

if ec2metadata --kernel-id |grep -q aki; then
    chmod -x /etc/grub.d/??_*
    chmod +x /etc/grub.d/40_custom
    aptconf_tag pvm
else
    chmod +x /etc/grub.d/??_*
    chmod -x /etc/grub.d/40_custom
    aptconf_tag hvm
fi

exit 0
