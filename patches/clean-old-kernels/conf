#!/bin/bash
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive

# The image kernel is selected by its own boot links, not the build host.
selected=$(readlink -f /vmlinuz)
[[ $selected == /boot/vmlinuz-* && -s $selected ]]
version=${selected#/boot/vmlinuz-}
[[ $(readlink -f /initrd.img) == /boot/initrd.img-"$version" ]]
[[ -s /boot/initrd.img-$version && -d /lib/modules/$version ]]
package=linux-image-$version
[[ $(dpkg-query -W -f='${db:Status-Status}' "$package") == installed ]]

old_kernels=()
while IFS=$'\t' read -r name status; do
    [[ $status == installed && $name == linux-image-[0-9]* && $name != "$package" ]] || continue
    old_kernels+=("$name")
done < <(dpkg-query -W -f='${Package}\t${db:Status-Status}\n' 'linux-image-*')
if ((${#old_kernels[@]})); then
    apt-get -y purge "${old_kernels[@]}"
fi
[[ $(readlink -f /vmlinuz) == "$selected" ]]
[[ -s $selected && -s /boot/initrd.img-$version && -d /lib/modules/$version ]]
for obsolete in "${old_kernels[@]}"; do
    old_version=${obsolete#linux-image-}
    [[ ! -e /boot/vmlinuz-$old_version && ! -e /boot/initrd.img-$old_version ]]
    [[ ! -d /lib/modules/$old_version ]]
done
printf 'KERNEL_CLEANUP_VERIFIED retained=%s removed=%s\n' "$version" "${old_kernels[*]:-none}"
